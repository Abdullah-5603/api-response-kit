{
  "name": "@abdullah5603/api-response-kit",
  "version": "0.1.1",
  "description": "Small, dependency-light TypeScript helpers for standardized API responses in Node.js and Express-style backends.",
  "keywords": [
    "api",
    "response",
    "express",
    "node",
    "http",
    "json",
    "typescript"
  ],
  "homepage": "https://github.com/Abdullah-5603/api-response-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abdullah-5603/api-response-kit.git"
  },
  "bugs": {
    "url": "https://github.com/Abdullah-5603/api-response-kit/issues"
  },
  "license": "MIT",
  "author": "Abdullah",
  "type": "module",
  "packageManager": "npm@11.11.0",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run clean && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "prettier": "^3.8.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  }
}
